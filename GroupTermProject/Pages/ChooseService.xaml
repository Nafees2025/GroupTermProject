<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GroupTermProject.ChooseService"
             BackgroundColor="#CECECE">
    
    <ContentPage.Resources>
        <!--Creating a basic styling for the navigation bar buttons-->
        <Style TargetType="Button">
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="Small"/>
            <Setter Property="BackgroundColor" Value="#D9D9D9"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="MaximumHeightRequest" Value="60"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout>
            <!--VerticalStackLayout to set the background color alongside allow the use of Grid formating-->
        <VerticalStackLayout BackgroundColor="#3A3A3A" Padding="5,10,5,10">

            <!--Grid definition for the navigation bar-->
            <Grid>
                <!--Row Definitions-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--Column Definitions-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Labels for the title of the application-->
                <Label Text="MIN" FontAttributes="Bold,Italic" FontSize="Header" TextColor="#3033FF" FontFamily="Inter" Grid.Column="0" Grid.Row="0"/>
                <Label Text="Cleaning Service" VerticalOptions="End" Margin="10,10,20,10" TextColor="White" FontFamily="Inter" TextType="Html" Grid.Column="1" Grid.Row="0" FontSize="Medium"/>

                <!--Adding all the buttons that will be in the navigation bar at the top of the home page-->
                <Button x:Name="HomeButton" Text="Home Page" Grid.Column="2" Grid.Row="0" Clicked="HomeButton_Clicked"/>
                <Button x:Name="CreatAccountButton" Text="Create Account" Grid.Column="3" Grid.Row="0" Clicked="CreatAccountButton_Clicked"/>
                    <Button x:Name="ServicePlanButton" Text="Service Plans"  Grid.Column="4" Grid.Row="0" BackgroundColor="#3033FF"/>
            </Grid>
        </VerticalStackLayout>


        <VerticalStackLayout>


                <VerticalStackLayout BackgroundColor="#353535" Margin="10,10,10,10"> 
                <VerticalStackLayout Background="#6B6B6B" Margin="20,20,20,20">

                    <VerticalStackLayout  BackgroundColor="#353535" Margin="20,20,20,20" Padding="5,5,5,5">
                        <Label Text="Pick a Plan" FontSize="Medium" VerticalOptions="Center"  HorizontalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <!--Grid definition for the navigation bar-->
                <Grid>
                    <!--Row Definitions-->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--Column Definitions-->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListView HorizontalOptions="Start" x:Name="PlanListView" ItemSelected="PlanListView_ItemSelected" Grid.Column="0" Grid.Row="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*,*,*" Margin="10">

                                        <!--service icon-->
                                        <Image Grid.Row="0" Grid.Column="0" Source="{Binding PlanTypeIcon}" WidthRequest="100" />
                                        <!--service image-->
                                        <Label Grid.Row="0" Grid.Column="1" VerticalOptions="Start" Text="{Binding ListViewInfo}"/>

                                    </Grid>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Image Grid.Column="1" Grid.Row="0" x:Name="planImage" Source="{Binding PlanImageFileName}" Margin="0,0,30,0" BackgroundColor="DimGrey"/>

            </Grid>
                </VerticalStackLayout>
               

                <!--add requests button-->
                    <Button Text="Choose Plan" FontSize="15" Clicked="ChoosePlan_Clicked" BackgroundColor="#4E4E4E" TextColor="White" WidthRequest="400" Margin="0,0,0,20" Padding="5,5,5,5"/>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>