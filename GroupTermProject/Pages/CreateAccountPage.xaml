<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GroupTermProject.NewPage1"
              BackgroundColor="#CECECE">

    <!--Using ContentPage.Resources to create a basic styling for the elements in this page-->
    <ContentPage.Resources>
        <!--Creating a basic styling for the navigation bar buttons-->
        <Style TargetType="Button">
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="Small"/>
            <Setter Property="BackgroundColor" Value="#D9D9D9"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="MaximumHeightRequest" Value="60"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
        </Style>

        <!--Creating basic styling for the Entrys-->
        <Style TargetType="Entry">
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="BackgroundColor" Value="#D9D9D9"/>
            <Setter Property="Margin" Value="20,10,20,10"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="PlaceholderColor" Value="#AFAFAF"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout>

            <!--VerticalStackLayout to set the background color alongside allow the use of Grid formating-->
            <VerticalStackLayout BackgroundColor="#3A3A3A" Padding="5,10,5,10">

                <!--Grid definition for the navigation bar-->
                <Grid>
                    <!--Row Definitions-->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--Column Definitions-->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--Labels for the title of the application-->
                    <Label Text="MIN" FontAttributes="Bold,Italic" FontSize="Header" TextColor="#3033FF" FontFamily="Inter" Grid.Column="0" Grid.Row="0"/>
                    <Label Text="Cleaning Service" VerticalOptions="End" Margin="10,10,20,10" TextColor="White" FontFamily="Inter" TextType="Html" Grid.Column="1" Grid.Row="0" FontSize="Medium"/>

                    <!--Adding all the buttons that will be in the navigation bar at the top of the home page-->
                    <Button x:Name="HomeButton" Text="Home Page" Grid.Column="2" Grid.Row="0" Clicked="HomeButton_Clicked"/>
                    <Button x:Name="CreatAccountButton" Text="Create Account" Grid.Column="3" Grid.Row="0" BackgroundColor="#3033FF"/>
                    <Button x:Name="ServicePlanButton" Text="Service Plans"  Grid.Column="4" Grid.Row="0" Clicked="ServicePlanButton_Clicked"/>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout BackgroundColor="#353535" Margin="10,10,10,10">
                <!-- VerticalStackLayout to create a box that will display the user input boxes-->
            <VerticalStackLayout BackgroundColor="#6B6B6B" Margin="20,20,20,20">

                <!--VerticalStackLayout for the styling of the title-->
                <VerticalStackLayout BackgroundColor="#353535" Margin="10,10,10,10">
                    <Label Text="Create Account" Padding="5,5,5,5" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="Medium"/>
                </VerticalStackLayout>

                <!--Entrys for user inputs-->
                <Entry x:Name="FirstNameInput" Placeholder="Enter First Name"/>
                <Entry x:Name="LastNameInput" Placeholder="Enter Last Name"/>
                <Entry x:Name="EmailInput" Placeholder="Enter Email" />
                <Entry x:Name="PasswordInput" Placeholder="Enter Password" />

                <!--HorizontalStackLayout to make chackBox and the label next to one another-->
                <HorizontalStackLayout>
                    <CheckBox x:Name="NewsLetterSubscription" IsChecked="False" Color="#D9D9D9" Margin="20,0,20,0"/>
                    <Label Text="Receive emails about special offers and deals" Margin="0,10,0,0" FontSize="Small" TextColor="White"/>
                </HorizontalStackLayout>

                <!--Create button-->
                    <Button x:Name="CreateAccount" Text="Create" Clicked="CreateAccount_Clicked" BackgroundColor="#4E4E4E" Margin="10,10,10,10" MaximumWidthRequest="450"  TextColor="White"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>